{
	"compatibility_date": "2026-06-09",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"name": "page-editor-poc",
	"main": "./dist/server/entry.mjs",
	"assets": {
		"directory": "./dist/client",
		"binding": "ASSETS"
	},
	"kv_namespaces": [
		{
			"binding": "SESSION",
			"id": "e8d747aec2214d3fac219be7a9a8c0e5"
		}
	],
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "acree-db",
			"database_id": "a228017e-d950-4fe8-b165-9e4836947e4b"
		}
	],
	"r2_buckets": [
		{
			"binding": "R2",
			"bucket_name": "acree-r2"
		}
	],
	"images": {
		"binding": "IMAGES"
	},
	"observability": {
		"enabled": true
	}
}